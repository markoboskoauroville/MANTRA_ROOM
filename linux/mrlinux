#!/bin/bash
# mrlinux: the Meditation Room (Linux) test stream on chromium-vm (MANTRA_ROOM/linux, Marko 15.11.2026).
#   mrlinux start [--preshow-until HH:MM]   private test relay + encoder (nothing public)
#   mrlinux stop                            stops live (if any), encoder and test relay
#   mrlinux status                          services, encoder numbers (speed ~1.0x), test relay path, site state
#   mrlinux go-live [min | --until HH:MM[:SS] [--no-site-stop]]  (default 5 min, max 2 h; --until in the noon window ends
#                                           11:58:30 at the latest; --no-site-stop = hand-over: site stays live, encoder exits) public relay path santoshi + site GO as camera "VM Test";
#                                           refused 11:50-13:50 Zagreb, while the site is live, or while santoshi has a publisher
#   mrlinux stop-live                       site STOP, public copy ends; the test stream keeps running
#   mrlinux text "words" | text --clear     words over the picture (line breaks: \n)
#   mrlinux title "words"                   the small title top left (default "Meditation Room")
#   mrlinux preshow HH:MM | preshow --off   countdown "Live stream in N minutes" and a card (one block, max 5 words, every 120 s)
#   mrlinux poster on [--every 120 --for 60] | poster off   the concert poster in silence between music (encoder restarts ~2 s)
#   mrlinux pause-live                      free path santoshi, no site STOP, encoder keeps running (go-live ... --resume after)
#   mrlinux checks                          would go-live be allowed now?
set -e
LIB=/usr/local/lib/meditation-room-linux
C=/home/ubuntu/.cache/mrlinux
mkdir -p "$C"
put() { printf '%b' "$2" > "$C/$1.tmp" && mv "$C/$1.tmp" "$C/$1"; }
case "${1:-status}" in
  start)
    if [ "$2" = "--preshow-until" ] && [ -n "$3" ]; then echo "$3" > "$C/preshow"; fi
    sudo systemctl start mrlinux-relay meditation-room-linux
    echo "started: test stream -> private relay vmtest (HLS http://100.102.86.30:8987/vmtest/index.m3u8, Tailscale only)";;
  stop)
    sudo systemctl stop mrlinux-live 2>/dev/null || true
    sudo systemctl stop meditation-room-linux mrlinux-relay
    echo "stopped";;
  go-live)
    nss=0; res=0; for x in "$@"; do [ "$x" = "--no-site-stop" ] && nss=1; [ "$x" = "--resume" ] && res=1; done
    if [ "$2" = "--until" ]; then
      m=$3; case "$m" in [0-2][0-9]:[0-5][0-9]|[0-2][0-9]:[0-5][0-9]:[0-5][0-9]) ;; *) echo "--until needs HH:MM or HH:MM:SS (Zagreb, max 2 h ahead)"; exit 2;; esac
    else
      m=${2:-5}; case "$m" in ''|*[!0-9]*) echo "minutes must be a whole number (or --until HH:MM)"; exit 2;; esac
      [ "$m" -gt 120 ] && m=120
    fi
    out=$(sudo MRL_RESUME=$res python3 $LIB/meditation_room_linux.py checks)
    case "$out" in "free to go live") ;; *) echo "$out"; exit 3;; esac
    printf 'MRL_MINUTES=%s\nMRL_NO_SITE_STOP=%s\nMRL_RESUME=%s\n' "$m" "$nss" "$res" | sudo tee /run/mrlinux-live.env >/dev/null
    sudo systemctl start mrlinux-live
    echo "going live, ends at $m (minutes or HH:MM[:SS]; a pre-show into the noon window ends 11:58:30 at the latest) (stop: mrlinux stop-live); log: journalctl -u mrlinux-live -f";;
  stop-live)
    sudo systemctl stop mrlinux-live; echo "live stopped";;
  pause-live)
    # hand-over runs only: free path santoshi WITHOUT site STOP and keep the encoder (then: go-live ... --resume)
    echo "MRL_KEEP_ENCODER=1" | sudo tee -a /run/mrlinux-live.env >/dev/null
    sudo systemctl stop mrlinux-live; sudo sed -i '/MRL_KEEP_ENCODER/d' /run/mrlinux-live.env; echo "live paused (site untouched)";;
  poster)
    if [ "$2" = "on" ]; then
      ev=120; fo=60; shift 2
      while [ -n "$1" ]; do case "$1" in --every) ev=$2; shift 2;; --for) fo=$2; shift 2;; *) shift;; esac; done
      printf '{"on": true, "every": %d, "for": %d}\n' "$ev" "$fo" > "$C/poster.json"; echo "poster on: every ${ev}s of music, ${fo}s poster in silence"
    else
      printf '{"on": false}\n' > "$C/poster.json"; echo "poster off"
    fi
    # the encoder picks it up at its next start: end the running ffmpeg, the service starts it again in ~1 s
    pid=$(python3 -c "import json;print(json.load(open('$C/status.json')).get('pid',''))" 2>/dev/null); [ -n "$pid" ] && kill "$pid" 2>/dev/null; true;;
  checks)
    sudo python3 $LIB/meditation_room_linux.py checks;;
  text)
    if [ "$2" = "--clear" ] || [ -z "$2" ]; then put text.txt ""; echo "text cleared"; else put text.txt "$2"; echo "text set"; fi;;
  title)
    put title.txt "${2:-Meditation Room}"; echo "title set";;
  preshow)
    if [ "$2" = "--off" ] || [ -z "$2" ]; then rm -f "$C/preshow"; echo "pre-show countdown off"; else echo "$2" > "$C/preshow"; echo "countdown to $2 (Zagreb)"; fi;;
  status)
    for u in mrlinux-relay meditation-room-linux mrlinux-live; do printf '%-24s %s\n' "$u" "$(systemctl is-active $u)"; done
    [ -f "$C/status.json" ] && cat "$C/status.json" && echo
    printf 'test relay path vmtest: '; curl -s --max-time 5 http://127.0.0.1:9996/v3/paths/get/vmtest | python3 -c 'import sys,json
try:
 d=json.load(sys.stdin); print("ready" if d.get("ready") else "no stream", "| readers", len(d.get("readers") or []), "| in", round((d.get("bytesReceived") or 0)/1e6,1), "MB")
except Exception: print("relay down")'
    printf 'site: '; curl -s --max-time 10 https://santoshi-band.pages.dev/api/live | python3 -c 'import sys,json; d=json.load(sys.stdin); print("LIVE via", d.get("via")) if d.get("live") else print("not live")';;
  *) sed -n 2,12p "$0"; exit 2;;
esac
